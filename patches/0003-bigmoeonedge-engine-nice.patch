 int main(int argc, char ** argv) {
+    // BMOE_NICE=<n>: scheduling priority for the whole engine (every thread created later inherits
+    // it). An app that runs the engine next to its own UI threads (nice -10 on Android) sets a
+    // matching value, so a UI frame no longer preempts one compute thread and stalls the rest at
+    // the next barrier. Android lets any process lower its nice value to -20 (RLIMIT_NICE 40).
+#if !defined(_WIN32)
+    if (const char * nv = std::getenv("BMOE_NICE")) {
+        if (setpriority(PRIO_PROCESS, 0, std::atoi(nv)) != 0) std::fprintf(stderr, "bmoe: BMOE_NICE=%s failed\n", nv);
+    }
+#endif
