+#pragma once
+
+// Batched expert matmuls for IQ2_XS and IQ3_XXS weights on ARM with dot-product instructions,
+// from ik_llama.cpp's iqk kernels (MIT, Copyright (C) 2024-2025 Iwan Kawrakow). See iqk-moe.cpp.
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Rows per work item when ggml_iqk_moe_mul_mat takes an expert with this weight type, row length,
+// number of rows and number of tokens; 0 when it does not. Off when GGML_IQK_MOE=0; an expert
+// with fewer tokens than GGML_IQK_MOE_MIN_ROWS (default 1: every expert, generation included)
+// stays on the generic path. The rows per item (GGML_IQK_MOE_CHUNK_ROWS, default 32) are a
+// multiple of 8.
+int ggml_iqk_moe_chunk_rows(int type, int64_t ne00, int64_t nrows, int64_t n_tokens);
+
+// Rows [row_start, row_end) of one expert times its n_tokens activation rows; both are multiples
+// of 8 (ggml_iqk_moe_chunk_rows takes only experts whose row count is). a: the expert's weights
+// from row 0, stride_a bytes per row. b: the Q8_K activations, stride_b bytes per row, row
+// (i11 + i12*ne11) for a mapping entry {i1, i2}, i11 = i1 % ne11, i12 = i2. c: the output, row
+// i1*nb1 + i2*nb2 bytes from c. row_mapping: n_tokens entries of {int32 i1, int32 i2}, as
+// ggml_compute_forward_mul_mat_id builds them.
+void ggml_iqk_moe_mul_mat(int type, int64_t row_start, int64_t row_end, int64_t ne00, int64_t ne11,
+                          const void * a, size_t stride_a,
+                          const void * b, size_t stride_b,
+                          float * c, size_t nb1, size_t nb2,
+                          const void * row_mapping, int64_t n_tokens);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ggml/src/ggml-cpu/test-iqk-moe.cpp b/ggml/src/ggml-cpu/test-iqk-moe.cpp
new file mode 100644
index 0000000..07ee60d
--- /dev/null
+++ b/ggml/src/ggml-cpu/test-iqk-moe.cpp
@@ -0,0 +1,113 @@
+// Accuracy of the iqk-moe kernels against ggml's own vec_dot, both against a double-precision
+// reference computed from the dequantized weights and the Q8_K activations. Random weight bits
+// (every bit pattern is a valid IQ2_XS / IQ3_XXS block once d is set), random activations.
+// Not part of the CMake build; on an aarch64 machine with dotprod, after a static build in build/:
+//   g++ -O2 -std=c++17 -mcpu=native -Iggml/include -Iggml/src/ggml-cpu ggml/src/ggml-cpu/test-iqk-moe.cpp \
+//     build/ggml/src/libggml.a build/ggml/src/libggml-cpu.a build/ggml/src/libggml-base.a \
+//     -fopenmp -lpthread -lm -o test-iqk-moe && ./test-iqk-moe
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "iqk-moe.h"
+
+#include <cmath>
+#include <cstdio>
+#include <algorithm>
+#include <cstring>
+#include <random>
+#include <vector>
+
+struct Q8K { float d; int8_t qs[256]; int16_t bsums[16]; };
+
+static uint16_t fp16(float f) { return ggml_fp32_to_fp16(f); }
+
+int main() {
+    std::mt19937 rng(42);
+    std::normal_distribution<float> nd(0.f, 1.f);
+    std::uniform_int_distribution<int> byte(0, 255);
+    int fails = 0;
+    for (int type : {GGML_TYPE_IQ2_XS, GGML_TYPE_IQ3_XXS}) {
+        for (int ne00 : {512, 2048}) {
+            const int Nx = 64;
+            const size_t ra = ggml_row_size((ggml_type)type, ne00);
+            const size_t blk = ggml_type_size((ggml_type)type);
+            std::vector<uint8_t> A(Nx*ra);
+            for (auto & b : A) b = byte(rng);
+            for (int r = 0; r < Nx; ++r)
+                for (int ib = 0; ib < ne00/256; ++ib) {
+                    uint16_t d = fp16(0.001f + 0.02f*std::abs(nd(rng)));
+                    std::memcpy(A.data() + r*ra + ib*blk, &d, 2);   // d is the first field of both blocks
+                }
+            std::vector<float> Af(Nx*ne00);
+            for (int r = 0; r < Nx; ++r) ggml_get_type_traits((ggml_type)type)->to_float(A.data() + r*ra, Af.data() + r*ne00, ne00);
+
+            for (int Ny : {1, 2, 3, 5, 8, 9, 13, 31, 32, 33, 47, 64, 100}) {
+                const size_t rb = ggml_row_size(GGML_TYPE_Q8_K, ne00);
+                std::vector<float> Bf(Ny*ne00);
+                for (auto & x : Bf) x = nd(rng);
+                std::vector<uint8_t> B(Ny*rb);
+                auto from_float = ggml_get_type_traits_cpu(GGML_TYPE_Q8_K)->from_float;
+                for (int t = 0; t < Ny; ++t) from_float(Bf.data() + t*ne00, B.data() + t*rb, ne00);
+                // reference in double, from what the kernels actually see
+                std::vector<double> ref(Ny*Nx);
+                double rms = 0;
+                for (int t = 0; t < Ny; ++t) {
+                    const Q8K * q = (const Q8K *)(B.data() + t*rb);
+                    for (int r = 0; r < Nx; ++r) {
+                        double s = 0;
+                        for (int j = 0; j < ne00; ++j) s += (double)Af[r*ne00 + j] * q[j/256].d * q[j/256].qs[j%256];
+                        ref[t*Nx + r] = s; rms += s*s;
+                    }
+                }
+                rms = std::sqrt(rms/(Ny*Nx));
+                // ggml's vec_dot
+                auto vec_dot = ggml_get_type_traits_cpu((ggml_type)type)->vec_dot;
+                double e_gen = 0;
+                for (int t = 0; t < Ny; ++t)
+                    for (int r = 0; r < Nx; ++r) {
+                        float s;
+                        vec_dot(ne00, &s, 0, A.data() + r*ra, 0, B.data() + t*rb, 0, 1);
+                        e_gen = std::max(e_gen, std::abs(s - ref[t*Nx + r]));
+                    }
+                // iqk, rows split over 3 "threads" run one after the other. Activations laid out as
+                // the down projection's: ne11 = 3 slots per token, row (i1 % ne11) + i2*ne11; token t
+                // sits at slot t % 3 of position t / 3. Output rows strided by slot (nb1) and position (nb2).
+                const int ne11 = 3, npos = (Ny + 2)/3;
+                std::vector<uint8_t> B3((size_t)npos*ne11*rb, 0);
+                std::vector<int32_t> map(2*Ny);
+                for (int t = 0; t < Ny; ++t) {
+                    const int i1 = t % 3 + 3*(t & 1), i2 = t / 3;   // i1 beyond ne11 exercises the modulo
+                    map[2*t] = i1; map[2*t+1] = i2;
+                    std::memcpy(B3.data() + ((i1 % ne11) + i2*ne11)*rb, B.data() + t*rb, rb);
+                }
+                const size_t nb1 = (Nx + 5) * sizeof(float), nb2 = 6*nb1;
+                std::vector<float> C((size_t)npos*6*(Nx + 5), NAN);
+                // rows in 16-row work items, in a shuffled order, as threads would claim them
+                const int chunk = ggml_iqk_moe_chunk_rows(type, ne00, Nx, Ny) ? 16 : 0;
+                const bool ok = chunk > 0 || Ny < 2;
+                std::vector<int> items;
+                for (int r0 = 0; chunk && r0 < Nx; r0 += chunk) items.push_back(r0);
+                std::shuffle(items.begin(), items.end(), rng);
+                for (int r0 : items)
+                    ggml_iqk_moe_mul_mat(type, r0, std::min(r0 + chunk, Nx), ne00, ne11, A.data(), ra, B3.data(), rb, C.data(), nb1, nb2, map.data(), Ny);
+                if (!chunk) continue;   // one token: the generic path's
+                double e_iqk = 0, e2 = 0;
+                for (int t = 0; t < Ny; ++t)
+                    for (int r = 0; r < Nx; ++r) {
+                        float s = *((const float *)((const char *)C.data() + map[2*t]*nb1 + map[2*t+1]*nb2) + r);
+                        double e = std::isnan(s) ? INFINITY : std::abs(s - ref[t*Nx + r]);
+                        e_iqk = std::max(e_iqk, e); e2 += e*e;
+                    }
+                const double rms_err = std::sqrt(e2/(Ny*Nx));
+                // below 32 tokens the kernels are exact up to float rounding; from 32 the weights are
+                // requantized to 8 bits per 256-weight block (ik's design), bounded here at 6% of rms
+                const double tol = Ny < 32 ? std::max(1e-5*rms, 20*e_gen) : 0.06*rms;
+                const bool bad = !ok || !(e_iqk <= tol);
+                fails += bad;
+                std::printf("%-8s ne00 %4d tokens %3d | rms %9.4f | max err generic %.2e iqk %.2e (rel %.1e, rms rel %.1e)%s\n",
+                    ggml_type_name((ggml_type)type), ne00, Ny, rms, e_gen, e_iqk, e_iqk/rms, rms_err/rms, bad ? "  <-- FAIL" : "");
+            }
+        }
+    }
+    std::printf(fails ? "FAILED %d\n" : "ALL OK\n", fails);
+    return fails != 0;
+}
