diff --git a/ggml/src/ggml-cpu/test-iqk-bf16.cpp b/ggml/src/ggml-cpu/test-iqk-bf16.cpp
new file mode 100644
index 0000000..66c8212
--- /dev/null
+++ b/ggml/src/ggml-cpu/test-iqk-bf16.cpp
@@ -0,0 +1,40 @@
+// Accuracy of ggml's BF16 dot product (vec.cpp, the NEON path on aarch64) against a
+// double-precision reference on the same BF16 values. Built like test-iqk-q2.cpp:
+//   c++ -O2 -std=c++17 -mcpu=native -Iggml/include -Iggml/src -Iggml/src/ggml-cpu \
+//     ggml/src/ggml-cpu/test-iqk-bf16.cpp build/ggml/src/libggml.a build/ggml/src/libggml-cpu.a \
+//     build/ggml/src/libggml-base.a -lpthread -lm -o test-iqk-bf16 && ./test-iqk-bf16
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <cmath>
+#include <cstdio>
+#include <random>
+#include <vector>
+
+int main() {
+    ggml_cpu_init();
+    const auto * tb = ggml_get_type_traits_cpu(GGML_TYPE_BF16);
+    std::mt19937 rng(7);
+    std::normal_distribution<float> nd(0.f, 1.f);
+    int fails = 0;
+    for (int n : {16, 320, 2560, 10240, 10241, 7}) {
+        double worst = 0;
+        for (int rep = 0; rep < 20; ++rep) {
+            std::vector<ggml_bf16_t> x(n), y(n);
+            for (int i = 0; i < n; ++i) { x[i] = ggml_fp32_to_bf16(nd(rng)); y[i] = ggml_fp32_to_bf16(nd(rng)); }
+            double ref = 0, mag = 0;
+            for (int i = 0; i < n; ++i) {
+                const double p = (double)ggml_bf16_to_fp32(x[i]) * ggml_bf16_to_fp32(y[i]);
+                ref += p; mag += std::fabs(p);
+            }
+            float s;
+            tb->vec_dot(n, &s, 0, x.data(), 0, y.data(), 0, 1);
+            worst = std::max(worst, std::fabs(s - ref)/mag);
+        }
+        const bool ok = worst < 1e-6;  // fp32 accumulation over these lengths: rounding only
+        printf("BF16 n=%d: max error %.2e of the sum of |products| %s\n", n, worst, ok ? "OK" : "FAIL");
+        fails += !ok;
+    }
+    printf("%s\n", fails ? "FAILED" : "all OK");
+    return fails ? 1 : 0;
+}
