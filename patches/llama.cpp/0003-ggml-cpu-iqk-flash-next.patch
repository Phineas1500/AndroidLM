+// ---- Q2_0 experts (Qwen3.8-Flash-Next): 64 weights per block, one fp16 scale, 2-bit codes for
+//      {-1, 0, 1, 2}. For several tokens each group of 8 rows is unpacked once to int8 (code - 1) in
+//      Q8_K_R8's interleave, the 8 scales as floats beside it, and multiplied by the Q8_0
+//      activations with the arithmetic of ggml_vec_dot_q2_0_q8_0: d*d8*dot(code - 1, y) per 32
+//      weights, the dot in integers. Nothing is quantized again.
+
+struct block_q2_0_u_r8 {
+    float  d[8];
+    int8_t qs[8*QK2_0];   // word (4 weights) l of row k at word index k + 8*l
+};
+static_assert(sizeof(block_q2_0_u_r8) == 8*sizeof(float) + 8*QK2_0, "wrong q2_0_u_r8 block size");
+
+inline size_t q2_0_u_r8_row_size(int n) { return (size_t)(n/QK2_0) * (sizeof(block_q2_0_u_r8)/8); }
+
+void iqk_unpack_q2_0_r8(int n, const void * vx, size_t bx, void * vy, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0 && n%QK2_0 == 0);
+    const int nb = n/QK2_0;
+    auto y = (block_q2_0_u_r8 *)vy;
+    const auto m3  = vdupq_n_u8(3);
+    const auto one = vdupq_n_u8(1);
+    for (int ix = 0; ix < nrc_x; ix += 8) {
+        const block_q2_0 * x8[8];
+        for (int k = 0; k < 8; ++k) x8[k] = (const block_q2_0 *)((const char *)vx + (ix + k)*bx);
+        for (int ib = 0; ib < nb; ++ib) {
+            uint32_t * qw = (uint32_t *)y[ib].qs;
+            for (int k = 0; k < 8; ++k) {
+                y[ib].d[k] = GGML_FP16_TO_FP32(x8[k][ib].d);
+                // byte i holds weights 4i..4i+3 at bit offsets 0, 2, 4, 6
+                const auto bits = vld1q_u8(x8[k][ib].qs);
+                uint8x16x4_t v;
+                v.val[0] = vsubq_u8(vandq_u8(bits, m3), one);
+                v.val[1] = vsubq_u8(vandq_u8(vshrq_n_u8(bits, 2), m3), one);
+                v.val[2] = vsubq_u8(vandq_u8(vshrq_n_u8(bits, 4), m3), one);
+                v.val[3] = vsubq_u8(vshrq_n_u8(bits, 6), one);
+                uint32_t w[16];
+                vst4q_u8((uint8_t *)w, v);  // the 64 weights in order
+                for (int l = 0; l < 16; ++l) qw[k + 8*l] = w[l];
+            }
+        }
+        y += nb;
+    }
+}
+
+template <int nrc_y>
+void mul_mat_q2_0_u_r8_q8_0(int n, const void * vx, size_t bx, const DataInfo& info, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0);
+    const int nb = n/QK2_0;
+    const block_q8_0 * y[nrc_y];
+    for (int iy = 0; iy < nrc_y; ++iy) y[iy] = (const block_q8_0 *)info.src1_row(iy);
+    float32x4_t acc[2*nrc_y];
+    for (int ix = 0; ix < nrc_x; ix += 8) {
+        const block_q2_0_u_r8 * iq = (const block_q2_0_u_r8 *)((const char *)vx + ix*bx);
+        for (int i = 0; i < 2*nrc_y; ++i) acc[i] = vdupq_n_f32(0.f);
+        for (int ib = 0; ib < nb; ++ib) {
+            const auto dl = vld1q_f32(iq[ib].d + 0);
+            const auto dh = vld1q_f32(iq[ib].d + 4);
+            for (int h = 0; h < 2; ++h) {
+                // one Q8_0 block of activations: 32 weights, two groups of 16 (128 bytes each)
+                int32x4_t isum[2*nrc_y];
+                for (int i = 0; i < 2*nrc_y; ++i) isum[i] = vdupq_n_s32(0);
+                for (int g = 0; g < 2; ++g) {
+                    const int8_t * qs = iq[ib].qs + 256*h + 128*g;
+                    const auto q1 = vld1q_s8_x4(qs);
+                    const auto q2 = vld1q_s8_x4(qs + 64);
+                    for (int iy = 0; iy < nrc_y; ++iy) {
+                        const auto yv = vld1q_s8(y[iy][2*ib + h].qs + 16*g);
+                        isum[2*iy+0] = vdotq_laneq_s32(isum[2*iy+0], q1.val[0], yv, 0);
+                        isum[2*iy+1] = vdotq_laneq_s32(isum[2*iy+1], q1.val[1], yv, 0);
+                        isum[2*iy+0] = vdotq_laneq_s32(isum[2*iy+0], q1.val[2], yv, 1);
+                        isum[2*iy+1] = vdotq_laneq_s32(isum[2*iy+1], q1.val[3], yv, 1);
+                        isum[2*iy+0] = vdotq_laneq_s32(isum[2*iy+0], q2.val[0], yv, 2);
+                        isum[2*iy+1] = vdotq_laneq_s32(isum[2*iy+1], q2.val[1], yv, 2);
+                        isum[2*iy+0] = vdotq_laneq_s32(isum[2*iy+0], q2.val[2], yv, 3);
+                        isum[2*iy+1] = vdotq_laneq_s32(isum[2*iy+1], q2.val[3], yv, 3);
+                    }
+                }
+                for (int iy = 0; iy < nrc_y; ++iy) {
+                    const float d8 = GGML_FP16_TO_FP32(y[iy][2*ib + h].d);
+                    acc[2*iy+0] = vfmaq_f32(acc[2*iy+0], vmulq_n_f32(dl, d8), vcvtq_f32_s32(isum[2*iy+0]));
+                    acc[2*iy+1] = vfmaq_f32(acc[2*iy+1], vmulq_n_f32(dh, d8), vcvtq_f32_s32(isum[2*iy+1]));
+                }
+            }
+        }
+        for (int iy = 0; iy < nrc_y; ++iy) {
+            info.store(ix+0, iy, acc[2*iy+0]);
+            info.store(ix+4, iy, acc[2*iy+1]);
+        }
+    }
+}
+
+// Q2_0 for one to three tokens (writing): no unpacking. The activations are rearranged once per
+// call: for each 32 weights, the 4 two-bit planes' activations (weights 4i+j for plane j, as
+// vld4 deinterleaves them), each repeated for a pair of rows, and their sum. Then 4 rows at a
+// time, row pairs side by side in one vector, each plane is masked out of the codes and dotted
+// with its activations: dot(code, y) - sum(y) = dot(code - 1, y), per 32 weights as
+// ggml_vec_dot_q2_0_q8_0 computes it.
+
+struct q2_0_act32 {
+    int8_t  p[4][16];  // plane j: y[4i + j], i = 0..7, twice
+    int32_t sum;       // sum of the 32 activations
+    float   d;
+};
+
+void iqk_q2_0_prepare_act(int n, const block_q8_0 * y, q2_0_act32 * a) {
+    for (int ib = 0; ib < n/32; ++ib) {
+        const int8x8x4_t v = vld4_s8(y[ib].qs);
+        for (int j = 0; j < 4; ++j) vst1q_s8(a[ib].p[j], vcombine_s8(v.val[j], v.val[j]));
+        a[ib].sum = vaddlvq_s8(vld1q_s8(y[ib].qs)) + vaddlvq_s8(vld1q_s8(y[ib].qs + 16));
+        a[ib].d   = GGML_FP16_TO_FP32(y[ib].d);
+    }
+}
+
+template <int nrc_y>
+void mul_mat_q2_0_q8_0_gemv(int n, const void * vx, size_t bx, const q2_0_act32 * const * act,
+                            const DataInfo& info, int nrc_x) {
+    GGML_ASSERT(nrc_x%4 == 0);
+    const int nb = n/QK2_0;
+    const auto m3 = vdupq_n_u8(3);
+    for (int ix = 0; ix < nrc_x; ix += 4) {
+        const block_q2_0 * x[4];
+        for (int k = 0; k < 4; ++k) x[k] = (const block_q2_0 *)((const char *)vx + (ix + k)*bx);
+        float32x4_t acc[nrc_y];
+        for (int iy = 0; iy < nrc_y; ++iy) acc[iy] = vdupq_n_f32(0.f);
+        for (int ib = 0; ib < nb; ++ib) {
+            float dw[4];
+            for (int k = 0; k < 4; ++k) dw[k] = GGML_FP16_TO_FP32(x[k][ib].d);
+            const auto d4 = vld1q_f32(dw);
+            const auto ra = vreinterpretq_u64_u8(vld1q_u8(x[0][ib].qs));
+            const auto rb = vreinterpretq_u64_u8(vld1q_u8(x[1][ib].qs));
+            const auto rc = vreinterpretq_u64_u8(vld1q_u8(x[2][ib].qs));
+            const auto rd = vreinterpretq_u64_u8(vld1q_u8(x[3][ib].qs));
+            for (int h = 0; h < 2; ++h) {
+                // the 8 code bytes of rows 0 and 1 (2 and 3) for weights 32*h ... 32*h + 31
+                const auto ab = vreinterpretq_u8_u64(h == 0 ? vzip1q_u64(ra, rb) : vzip2q_u64(ra, rb));
+                const auto cd = vreinterpretq_u8_u64(h == 0 ? vzip1q_u64(rc, rd) : vzip2q_u64(rc, rd));
+                const int8x16_t pab[4] = {vreinterpretq_s8_u8(vandq_u8(ab, m3)),
+                                          vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(ab, 2), m3)),
+                                          vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(ab, 4), m3)),
+                                          vreinterpretq_s8_u8(vshrq_n_u8(ab, 6))};
+                const int8x16_t pcd[4] = {vreinterpretq_s8_u8(vandq_u8(cd, m3)),
+                                          vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(cd, 2), m3)),
+                                          vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(cd, 4), m3)),
+                                          vreinterpretq_s8_u8(vshrq_n_u8(cd, 6))};
+                for (int iy = 0; iy < nrc_y; ++iy) {
+                    const q2_0_act32 & a = act[iy][2*ib + h];
+                    int32x4_t sab = vdupq_n_s32(0), scd = vdupq_n_s32(0);
+                    for (int j = 0; j < 4; ++j) {
+                        const auto y = vld1q_s8(a.p[j]);
+                        sab = vdotq_s32(sab, pab[j], y);
+                        scd = vdotq_s32(scd, pcd[j], y);
+                    }
+                    // lanes 0-1 row 0 (2), lanes 2-3 row 1 (3): pairwise sums give the 4 rows' dots
+                    const auto s = vsubq_s32(vpaddq_s32(sab, scd), vdupq_n_s32(a.sum));
+                    acc[iy] = vfmaq_f32(acc[iy], vmulq_n_f32(d4, a.d), vcvtq_f32_s32(s));
+                }
+            }
+        }
+        for (int iy = 0; iy < nrc_y; ++iy) info.store(ix, iy, acc[iy]);
+    }
+}
