+                           vreinterpretq_f32_u32(vshll_n_u16(vget_low_u16(ya), 16)));
+        c1 = vfmaq_f32(c1, vreinterpretq_f32_u32(vshll_high_n_u16(xa, 16)),
+                           vreinterpretq_f32_u32(vshll_high_n_u16(ya, 16)));
+        c2 = vfmaq_f32(c2, vreinterpretq_f32_u32(vshll_n_u16(vget_low_u16(xb), 16)),
+                           vreinterpretq_f32_u32(vshll_n_u16(vget_low_u16(yb), 16)));
