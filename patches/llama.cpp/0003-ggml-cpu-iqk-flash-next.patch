+// ---- dense Q3_K, IQ4_XS, Q2_0 and BF16 weights, which llama.cpp has no batched ARM kernel for
+//      (Qwen3.8-Flash-Next keeps its attention, shared-expert and hyper-connection matrices in
+//      them): for a prompt each row is unpacked once, instead of decoded once per token.
+//      Q3_K and IQ4_XS go into block_q6k_u_r8, whose kernel does d*d8*sum_j(sc_j*dot(q, x)) per 16
+//      weights; with q and sc_j as below that is the integer arithmetic of ggml's own
+//      vec_dot_q3_K_q8_K and vec_dot_iq4_xs_q8_K:
+//        Q3_K:   q = 2 low bits, minus 4 where the hmask bit is unset (-4..3); sc_j = 6-bit scale - 32
+//        IQ4_XS: q = kvalues_iq4nl[4-bit index]; sc_j = the 6-bit scale of its 32 weights - 32
+//      Q2_0 goes through the experts' kernel above. BF16 rows go to fp32, 8 rows interleaved per
+//      weight, multiplied in fp32 by the BF16 activations, as ggml_vec_dot_bf16 multiplies them.
+
+static const int8_t kvalues_iq4nl_u[16] = {-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113};
+
+void iqk_unpack_q3_k_r8(int n, const void * vx, size_t bx, void * vy, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0 && n%QK_K == 0);
+    const int nb = n/QK_K;
+    auto y = (block_q6k_u_r8 *)vy;
+    int8_t q[QK_K];
+    for (int ix = 0; ix < nrc_x; ix += 8) {
+        for (int k = 0; k < 8; ++k) {
+            const block_q3_K * x = (const block_q3_K *)((const char *)vx + (ix + k)*bx);
+            for (int i = 0; i < nb; ++i) {
+                y[i].d[k] = x[i].d;
+                // the 16 6-bit scales, as dequantize_row_q3_K unpacks them
+                uint32_t aux[4];
+                std::memcpy(aux, x[i].scales, 12);
+                const uint32_t kmask1 = 0x03030303, kmask2 = 0x0f0f0f0f, tmp = aux[2];
+                aux[2] = ((aux[0] >> 4) & kmask2) | (((tmp >> 4) & kmask1) << 4);
+                aux[3] = ((aux[1] >> 4) & kmask2) | (((tmp >> 6) & kmask1) << 4);
+                aux[0] = (aux[0] & kmask2) | (((tmp >> 0) & kmask1) << 4);
+                aux[1] = (aux[1] & kmask2) | (((tmp >> 2) & kmask1) << 4);
+                const int8_t * sc = (const int8_t *)aux;
+                for (int j = 0; j < 16; ++j) y[i].sc[8*j + k] = (int8_t)(sc[j] - 32);
+                const uint8_t * qs = x[i].qs;
+                const uint8_t * hm = x[i].hmask;
+                uint8_t m = 1;
+                int8_t * o = q;
+                for (int h = 0; h < QK_K; h += 128) {
+                    for (int shift = 0; shift < 8; shift += 2, m <<= 1) {
+                        for (int l = 0; l < 32; ++l) *o++ = (int8_t)(((qs[l] >> shift) & 3) - ((hm[l] & m) ? 0 : 4));
+                    }
+                    qs += 32;
+                }
+                for (int ib32 = 0; ib32 < 8; ++ib32) store_r8(q + 32*ib32, k, ib32, y[i].qs);
+            }
+        }
+        y += nb;
+    }
+}
+
+void iqk_unpack_iq4_xs_r8(int n, const void * vx, size_t bx, void * vy, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0 && n%QK_K == 0);
+    const int nb = n/QK_K;
+    auto y = (block_q6k_u_r8 *)vy;
+    int8_t q[QK_K];
+    for (int ix = 0; ix < nrc_x; ix += 8) {
+        for (int k = 0; k < 8; ++k) {
+            const block_iq4_xs * x = (const block_iq4_xs *)((const char *)vx + (ix + k)*bx);
+            for (int i = 0; i < nb; ++i) {
+                y[i].d[k] = x[i].d;
+                const uint8_t * qs = x[i].qs;
+                for (int ib = 0; ib < QK_K/32; ++ib) {
+                    const int ls = ((x[i].scales_l[ib/2] >> 4*(ib%2)) & 0xf) | (((x[i].scales_h >> 2*ib) & 3) << 4);
+                    y[i].sc[8*(2*ib + 0) + k] = (int8_t)(ls - 32);
+                    y[i].sc[8*(2*ib + 1) + k] = (int8_t)(ls - 32);
+                    for (int j = 0; j < 16; ++j) {
+                        q[32*ib + j]      = kvalues_iq4nl_u[qs[j] & 0xf];
+                        q[32*ib + j + 16] = kvalues_iq4nl_u[qs[j] >> 4];
+                    }
+                    qs += 16;
+                }
+                for (int ib32 = 0; ib32 < 8; ++ib32) store_r8(q + 32*ib32, k, ib32, y[i].qs);
+            }
+        }
+        y += nb;
+    }
+}
+
+// BF16: 8 rows of n weights as fp32, weight e of row k at (e/4)*32 + (e%4)*8 + k
+void iqk_unpack_bf16_r8(int n, const void * vx, size_t bx, void * vy, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0 && n%4 == 0);
+    for (int ix = 0; ix < nrc_x; ix += 8) {
+        float * w = (float *)vy + (size_t)ix*n;
+        for (int k = 0; k < 8; ++k) {
+            const uint16_t * x = (const uint16_t *)((const char *)vx + (ix + k)*bx);
+            for (int e = 0; e < n; ++e) {
+                const uint32_t u = (uint32_t)x[e] << 16;
+                std::memcpy(w + (e/4)*32 + (e%4)*8 + k, &u, sizeof(float));
+            }
+        }
+    }
+}
+
+template <int nrc_y>
+void mul_mat_bf16_r8_bf16(int n, const void * vx, size_t bx, const DataInfo& info, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0 && n%4 == 0);
+    const uint16_t * y[nrc_y];
+    for (int iy = 0; iy < nrc_y; ++iy) y[iy] = (const uint16_t *)info.src1_row(iy);
+    float32x4_t acc[2*nrc_y];
+    for (int ix = 0; ix < nrc_x; ix += 8) {
+        const float * w = (const float *)((const char *)vx + ix*bx);
+        for (int i = 0; i < 2*nrc_y; ++i) acc[i] = vdupq_n_f32(0.f);
+        for (int e = 0; e < n; e += 4, w += 32) {
+            const auto w0 = vld1q_f32_x4(w);       // weights e, e+1 of rows 0-3, 4-7
+            const auto w1 = vld1q_f32_x4(w + 16);  // weights e+2, e+3
+            for (int iy = 0; iy < nrc_y; ++iy) {
+                const auto a = vreinterpretq_f32_u32(vshll_n_u16(vld1_u16(y[iy] + e), 16));
+                acc[2*iy+0] = vfmaq_laneq_f32(acc[2*iy+0], w0.val[0], a, 0);
+                acc[2*iy+1] = vfmaq_laneq_f32(acc[2*iy+1], w0.val[1], a, 0);
+                acc[2*iy+0] = vfmaq_laneq_f32(acc[2*iy+0], w0.val[2], a, 1);
+                acc[2*iy+1] = vfmaq_laneq_f32(acc[2*iy+1], w0.val[3], a, 1);
+                acc[2*iy+0] = vfmaq_laneq_f32(acc[2*iy+0], w1.val[0], a, 2);
+                acc[2*iy+1] = vfmaq_laneq_f32(acc[2*iy+1], w1.val[1], a, 2);
+                acc[2*iy+0] = vfmaq_laneq_f32(acc[2*iy+0], w1.val[2], a, 3);
+                acc[2*iy+1] = vfmaq_laneq_f32(acc[2*iy+1], w1.val[3], a, 3);
+            }
+        }
+        for (int iy = 0; iy < nrc_y; ++iy) {
+            info.store(ix+0, iy, acc[2*iy+0]);
+            info.store(ix+4, iy, acc[2*iy+1]);
+        }
+    }
+}
+
+// BF16 with BFMMLA (FEAT_BF16): 2 rows x 4 weights times 2 tokens x 4 activations into a 2x2 block
+// of fp32 sums, 16 multiply-adds per instruction against 4 for fp32 FMA. The rows stay BF16,
+// reordered once: for 8 rows and each 4 weights, row pairs (0,1) (2,3) (4,5) (6,7), 8 values each.
+// The products are exact; BFMMLA sums them in fp32 with its own rounding, so the result differs
+// from ggml_vec_dot_bf16's at float rounding.
+#define IQK_BF16 __attribute__((target("bf16")))
+
+void iqk_unpack_bf16_mmla(int n, const void * vx, size_t bx, void * vy, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0 && n%4 == 0);
