--- /dev/null
+++ b/ggml/src/ggml-cpu/test-iqk-dense2.cpp
@@ -0,0 +1,76 @@
+// Accuracy of ggml_iqk_dense2_mul_mat (iqk-moe.cpp) on dense Q3_K, IQ4_XS, Q2_0 and BF16 weights,
+// against ggml's own vec_dot on the same rows and the same activations (quantized to the type's
+// vec_dot_type as ggml_compute_forward_mul_mat does). The weights are random floats quantized by
+// ggml. Built like test-iqk-q2.cpp:
+//   c++ -O2 -std=c++17 -mcpu=native -Iggml/include -Iggml/src -Iggml/src/ggml-cpu \
+//     ggml/src/ggml-cpu/test-iqk-dense2.cpp build/ggml/src/libggml.a build/ggml/src/libggml-cpu.a \
+//     build/ggml/src/libggml-base.a -lpthread -lm -o test-iqk-dense2 && ./test-iqk-dense2
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "iqk-moe.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <random>
+#include <vector>
+
+static int run(ggml_type type, int ne00, int nrows, int ntok, std::mt19937 & rng) {
+    const auto * tw = ggml_get_type_traits_cpu(type);
+    const ggml_type vt = tw->vec_dot_type;
+    const auto * tv = ggml_get_type_traits_cpu(vt);
+    const size_t row_a = ggml_row_size(type, ne00);
+    const size_t row_b = ggml_row_size(vt, ne00);
+
+    std::normal_distribution<float> nd(0.f, 1.f);
+    std::vector<float> wf((size_t)nrows*ne00), xf(ne00);
+    for (auto & v : wf) v = 0.05f*nd(rng);
+    std::vector<uint8_t> a(row_a*nrows), b(row_b*ntok);
+    ggml_quantize_chunk(type, wf.data(), a.data(), 0, nrows, ne00, nullptr);
+    for (int t = 0; t < ntok; ++t) {
+        for (auto & v : xf) v = nd(rng);
+        tv->from_float(xf.data(), b.data() + t*row_b, ne00);
+    }
+
+    std::vector<float> c((size_t)nrows*ntok, NAN);
+    const int chunk = ggml_iqk_dense2_chunk_rows(type, ne00, nrows, ntok);
+    if (chunk <= 0) { printf("%s ne00=%d rows=%d tokens=%d: not taken\n", ggml_type_name(type), ne00, nrows, ntok); return 1; }
+    for (int r0 = 0; r0 < nrows; r0 += chunk) {
+        ggml_iqk_dense2_mul_mat(type, r0, std::min(r0 + chunk, nrows), ne00, a.data(), row_a, b.data(), row_b,
+                                c.data(), nrows*sizeof(float), ntok);
+    }
+    double max_err = 0, sum_sq = 0;
+    for (int t = 0; t < ntok; ++t) {
+        for (int r = 0; r < nrows; ++r) {
+            float vd;
+            tw->vec_dot(ne00, &vd, 0, a.data() + r*row_a, 0, b.data() + t*row_b, 0, 1);
+            max_err = std::max(max_err, (double)std::fabs(c[(size_t)t*nrows + r] - vd));
+            sum_sq += (double)vd*vd;
+        }
+    }
+    const double rel = max_err/std::sqrt(sum_sq/((double)nrows*ntok));
+    const bool ok = rel < 2e-5;  // the same products as ggml's vec_dot, summed in another order
+    printf("%-7s ne00=%5d rows=%5d tokens=%3d: max difference from ggml's vec_dot %.2e of the output RMS %s\n",
+           ggml_type_name(type), ne00, nrows, ntok, rel, ok ? "OK" : "FAIL");
+    return ok ? 0 : 1;
+}
+
+int main() {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    ggml_cpu_init();
+    std::mt19937 rng(11);
+    int fails = 0;
+    // Flash-Next's shapes: attention / shared-expert projections from 2560, hyper-connections
+    // 10240 -> 320 and back, the router 2560 -> 512
+    for (int ntok : {32, 37, 100}) {
+        fails += run(GGML_TYPE_Q3_K,   2560, 640,   ntok, rng);
+        fails += run(GGML_TYPE_IQ4_XS, 2560, 512,   ntok, rng);
+        fails += run(GGML_TYPE_IQ4_XS, 6144, 64,    ntok, rng);
+        fails += run(GGML_TYPE_Q2_0,   2560, 640,   ntok, rng);
+        fails += run(GGML_TYPE_BF16,   10240, 320,  ntok, rng);
+        fails += run(GGML_TYPE_BF16,   320, 1024,   ntok, rng);
+        fails += run(GGML_TYPE_BF16,   2560, 48,    ntok, rng);
+    }
+    printf("%s\n", fails ? "FAILED" : "all OK");
+    return fails ? 1 : 0;
+}
diff --git a/ggml/src/ggml-cpu/test-iqk-q2.cpp b/ggml/src/ggml-cpu/test-iqk-q2.cpp
new file mode 100644
index 0000000..489eef1
--- /dev/null
+++ b/ggml/src/ggml-cpu/test-iqk-q2.cpp
@@ -0,0 +1,99 @@
+// Accuracy of ggml_iqk_moe_mul_mat (iqk-moe.cpp) on Q2_0 expert weights, against a
+// double-precision reference computed from the Q2_0 weights and the Q8_0 activations, next to
+// ggml's own vec_dot on the same data. The weights are random Q2_0 rows (random codes and scales),
+// the activations random floats quantized to Q8_0 as mul_mat_id does.
+// Not part of the CMake build; on an aarch64 machine with dotprod, after a static build in build/:
+//   c++ -O2 -std=c++17 -mcpu=native -Iggml/include -Iggml/src -Iggml/src/ggml-cpu \
+//     ggml/src/ggml-cpu/test-iqk-q2.cpp build/ggml/src/libggml.a build/ggml/src/libggml-cpu.a \
+//     build/ggml/src/libggml-base.a -lpthread -lm -o test-iqk-q2 && ./test-iqk-q2
+#define GGML_COMMON_DECL_CPP
+#include "ggml-common.h"
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "iqk-moe.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+struct row_map { int32_t i1, i2; };
+
+static int run(int ne00, int nrows, int ntok, std::mt19937 & rng) {
+    const auto * tq = ggml_get_type_traits_cpu(GGML_TYPE_Q2_0);
+    const auto * t8 = ggml_get_type_traits_cpu(GGML_TYPE_Q8_0);
+    const size_t row_a = ggml_row_size(GGML_TYPE_Q2_0, ne00);
+    const size_t row_b = ggml_row_size(GGML_TYPE_Q8_0, ne00);
+
+    std::uniform_int_distribution<int> byte(0, 255);
+    std::normal_distribution<float> nd(0.f, 1.f);
+    std::vector<uint8_t> a(row_a*nrows);
+    for (int r = 0; r < nrows; ++r) {
+        auto * blk = (block_q2_0 *)(a.data() + r*row_a);
+        for (int ib = 0; ib < ne00/QK2_0; ++ib) {
+            blk[ib].d = ggml_fp32_to_fp16(0.01f + 0.02f*std::fabs(nd(rng)));
+            for (int j = 0; j < QK2_0/4; ++j) blk[ib].qs[j] = (uint8_t)byte(rng);
+        }
+    }
+    std::vector<float> xf(ne00);
+    std::vector<uint8_t> b(row_b*ntok);
+    for (int t = 0; t < ntok; ++t) {
+        for (auto & v : xf) v = nd(rng);
+        t8->from_float(xf.data(), b.data() + t*row_b, ne00);
+    }
+
+    // mul_mat_id's layout: one activation row per token (ne11 = 1), output row t of nrows floats
+    std::vector<row_map> map(ntok);
+    for (int t = 0; t < ntok; ++t) map[t] = {0, t};
+    std::vector<float> c(nrows*ntok, NAN);
+    const int chunk = ggml_iqk_moe_chunk_rows(GGML_TYPE_Q2_0, ne00, nrows, ntok);
+    if (chunk <= 0) { printf("Q2_0 ne00=%d rows=%d tokens=%d: not taken\n", ne00, nrows, ntok); return 1; }
+    for (int r0 = 0; r0 < nrows; r0 += chunk) {
+        ggml_iqk_moe_mul_mat(GGML_TYPE_Q2_0, r0, std::min(r0 + chunk, nrows), ne00, 1,
+                             a.data(), row_a, b.data(), row_b, c.data(), 0, nrows*sizeof(float), map.data(), ntok);
+    }
+
+    double max_err = 0, max_err_vd = 0, sum_sq = 0;
+    for (int t = 0; t < ntok; ++t) {
+        const auto * yb = (const block_q8_0 *)(b.data() + t*row_b);
+        for (int r = 0; r < nrows; ++r) {
+            const auto * xb = (const block_q2_0 *)(a.data() + r*row_a);
+            double ref = 0;
+            for (int ib = 0; ib < ne00/QK2_0; ++ib) {
+                const double d = ggml_fp16_to_fp32(xb[ib].d);
+                for (int e = 0; e < QK2_0; ++e) {
+                    const int q = ((xb[ib].qs[e/4] >> (2*(e%4))) & 3) - 1;
+                    const auto & y = yb[(ib*QK2_0 + e)/32];
+                    ref += d*q * (double)ggml_fp16_to_fp32(y.d)*y.qs[e%32];
+                }
+            }
+            float vd;
+            tq->vec_dot(ne00, &vd, 0, xb, 0, yb, 0, 1);
+            max_err    = std::max(max_err,    std::fabs(c[t*nrows + r] - ref));
+            max_err_vd = std::max(max_err_vd, std::fabs(vd - ref));
+            sum_sq += ref*ref;
+        }
+    }
+    const double rms = std::sqrt(sum_sq/(nrows*ntok));
+    const double rel = max_err/rms, rel_vd = max_err_vd/rms;
+    const bool ok = rel < 2e-5;  // the integer arithmetic of ggml's own dot product: rounding only
+    printf("Q2_0 ne00=%d rows=%d tokens=%d: max error %.2e of the output RMS (ggml vec_dot %.2e) %s\n",
+           ne00, nrows, ntok, rel, rel_vd, ok ? "OK" : "FAIL");
+    return ok ? 0 : 1;
+}
+
+int main() {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    ggml_cpu_init();
+    std::mt19937 rng(42);
+    int fails = 0;
+    // Flash-Next's experts: gate/up 2560 -> 640, down 640 -> 2560
+    for (int ntok : {1, 2, 3, 4, 7, 8, 9, 24, 100}) {
+        fails += run(2560, 640, ntok, rng);
+        fails += run(640, 2560, ntok, rng);
+    }
+    fails += run(128, 40, 5, rng);
+    printf("%s\n", fails ? "FAILED" : "all OK");
+    return fails ? 1 : 0;
+}
