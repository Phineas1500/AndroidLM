+// ---- dense weights: llama.cpp's repacked Q5_K and Q6_K (8 rows interleaved in blocks of B bytes,
+//      repack.h's block_q5_Kx8 and block_q6_Kx8, as make_block_q5_Kx8 / make_block_q6_Kx8 build
+//      them), unpacked once per prompt instead of once per four tokens: the 5- and 6-bit integers
+//      to int8 in Q8_K_R8's order, their own integer scales and mins beside them. The kernels then
+//      do the arithmetic of llama.cpp's Q5_K / Q6_K dot products in integers, nothing is quantized
+//      again:
+//        Q5_K: d*d8*sum_sb(sc*dot(q, x)) - dmin*d8*sum_sb(m*sum(x))   (q 0..31, per 32 weights)
+//        Q6_K: d*d8*sum_j(sc*dot(q - 32, x))                           (per 16 weights)
+
+struct blk_q5_Kx8 {
+    ggml_half d[8];
+    ggml_half dmin[8];
+    uint8_t   scales[96];
+    uint8_t   qh[QK_K];
+    uint8_t   qs[QK_K*4];
+};
+static_assert(sizeof(blk_q5_Kx8) == 16*sizeof(ggml_half) + 96 + 5*QK_K, "must match repack.h's block_q5_Kx8");
+
+struct blk_q6_Kx8 {
+    ggml_half d[8];
+    int8_t    scales[QK_K/16*8];
+    uint8_t   ql[QK_K/2*8];
+    uint8_t   qh[QK_K/4*8];
+};
+static_assert(sizeof(blk_q6_Kx8) == 8*sizeof(ggml_half) + QK_K/16*8 + 3*QK_K/4*8, "must match repack.h's block_q6_Kx8");
+
+// unpacked: 8 rows of 256 weights
+typedef struct {
+    ggml_half d[8];
+    ggml_half dmin[8];
+    uint8_t   sc[8*8];      // sc[8*sb + k]: row k, weights 32*sb ... 32*sb + 31
+    uint8_t   m[8*8];       // the same for the mins
+    int8_t    qs[8*QK_K];   // q in 0..31, in block_q8_k_r8's order
+} block_q5k_u_r8;
+
+typedef struct {
+    ggml_half d[8];
+    int8_t    sc[16*8];     // sc[8*j + k]: row k, weights 16*j ... 16*j + 15 (block_q6_Kx8's order)
+    int8_t    qs[8*QK_K];   // q - 32, in block_q8_k_r8's order
+} block_q6k_u_r8;
+
+inline size_t dense_u_row_size(int type, int n) {
+    return (size_t)(n/QK_K) * (type == GGML_TYPE_Q5_K ? sizeof(block_q5k_u_r8) : sizeof(block_q6k_u_r8))/8;
+}
+
+inline size_t dense_x8_group_size(int type, int n) {
+    return (size_t)(n/QK_K) * (type == GGML_TYPE_Q5_K ? sizeof(blk_q5_Kx8) : sizeof(blk_q6_Kx8));
+}
+
+// byte p of row k's own array, interleaved B bytes at a time over the 8 rows
+template <int B> inline uint8_t ileave(const uint8_t * x, int k, int p) { return x[((p/B)*8 + k)*B + p%B]; }
+
+// 32 int8 values of row k, sub-block ib32, into block_q8_k_r8's order
+inline void store_r8(const int8_t * v, int k, int ib32, int8_t * qs) {
+    uint32_t * q8 = (uint32_t *)qs + k + 64*ib32;
+    for (int l = 0; l < 8; ++l) {
+        uint32_t u;
+        std::memcpy(&u, v + 4*l, 4);
+        q8[8*l] = u;
+    }
+}
+
+// 32 int8 values of row k, sub-block sb, in the order the i8mm kernels read: per sub-block, for
+// each 8 weights (kc) and each row pair (rp), 16 bytes: row 2*rp's 8 weights, then row 2*rp+1's
+inline void store_i8mm(const int8_t * v, int k, int sb, int8_t * qs) {
+    for (int kc = 0; kc < 4; ++kc) std::memcpy(qs + 256*sb + 64*kc + 16*(k/2) + 8*(k%2), v + 8*kc, 8);
+}
+
+template <bool I8> inline void store_q(const int8_t * v, int k, int sb, int8_t * qs) {
+    if constexpr (I8) store_i8mm(v, k, sb, qs); else store_r8(v, k, sb, qs);
+}
+
+template <int B, bool I8>
+void iqk_unpack_q5_k_x8(int n, const void * vx, void * vy) {
+    const int nb = n/QK_K;
+    const blk_q5_Kx8 * x = (const blk_q5_Kx8 *)vx;
+    block_q5k_u_r8 * y = (block_q5k_u_r8 *)vy;
+    int8_t q[QK_K];
+    for (int i = 0; i < nb; ++i) {
+        std::memcpy(y[i].d, x[i].d, sizeof(y[i].d));
+        std::memcpy(y[i].dmin, x[i].dmin, sizeof(y[i].dmin));
+        for (int k = 0; k < 8; ++k) {
+            for (int sb = 0; sb < 8; ++sb) {
+                const uint8_t * s = x[i].scales + (sb < 4 ? 12*sb : 48 + 12*(sb - 4));
+                if (k < 4) {
+                    y[i].sc[8*sb + k] = s[k] & 63;
+                    y[i].m [8*sb + k] = s[4 + k] & 63;
+                } else {
+                    const int j = k - 4;
+                    y[i].sc[8*sb + k] = (s[8 + j] & 15) | ((s[j]     >> 6) << 4);
+                    y[i].m [8*sb + k] = (s[8 + j] >> 4) | ((s[4 + j] >> 6) << 4);
+                }
+            }
+            for (int j = 0; j < 4; ++j) {
+                for (int l = 0; l < 32; ++l) {
+                    const uint8_t qs = ileave<B>(x[i].qs, k, 32*j + l);
+                    const uint8_t qh = ileave<B>(x[i].qh, k, l);
+                    q[64*j + l]      = (int8_t)((qs & 0xF) + (((qh >> (2*j))   & 1) << 4));
+                    q[64*j + 32 + l] = (int8_t)((qs >> 4)  + (((qh >> (2*j+1)) & 1) << 4));
+                }
+            }
+            for (int ib32 = 0; ib32 < 8; ++ib32) store_q<I8>(q + 32*ib32, k, ib32, y[i].qs);
+        }
+    }
+}
+
+template <int B, bool I8>
+void iqk_unpack_q6_k_x8(int n, const void * vx, void * vy) {
+    const int nb = n/QK_K;
+    const blk_q6_Kx8 * x = (const blk_q6_Kx8 *)vx;
+    block_q6k_u_r8 * y = (block_q6k_u_r8 *)vy;
+    int8_t q[QK_K];
+    for (int i = 0; i < nb; ++i) {
+        std::memcpy(y[i].d, x[i].d, sizeof(y[i].d));
+        std::memcpy(y[i].sc, x[i].scales, sizeof(y[i].sc));
+        for (int k = 0; k < 8; ++k) {
+            for (int h = 0; h < 2; ++h) {
+                for (int l = 0; l < 32; ++l) {
+                    const uint8_t ql0 = ileave<B>(x[i].ql, k, 64*h + l);
+                    const uint8_t ql1 = ileave<B>(x[i].ql, k, 64*h + 32 + l);
+                    const uint8_t qh  = ileave<B>(x[i].qh, k, 32*h + l);
+                    q[128*h + l]      = (int8_t)((ql0 & 0xF) | (((qh >> 0) & 3) << 4)) - 32;
+                    q[128*h + 32 + l] = (int8_t)((ql1 & 0xF) | (((qh >> 2) & 3) << 4)) - 32;
+                    q[128*h + 64 + l] = (int8_t)((ql0 >> 4)  | (((qh >> 4) & 3) << 4)) - 32;
+                    q[128*h + 96 + l] = (int8_t)((ql1 >> 4)  | (((qh >> 6) & 3) << 4)) - 32;
+                }
+            }
+            for (int ib32 = 0; ib32 < 8; ++ib32) store_q<I8>(q + 32*ib32, k, ib32, y[i].qs);
+        }
+    }
+}
+
+inline int32x4x2_t widen_u8(const uint8_t * v) {
+    const uint16x8_t w = vmovl_u8(vld1_u8(v));
+    return {vreinterpretq_s32_u32(vmovl_u16(vget_low_u16(w))), vreinterpretq_s32_u32(vmovl_u16(vget_high_u16(w)))};
+}
+inline int32x4x2_t widen_s8(const int8_t * v) {
+    const int16x8_t w = vmovl_s8(vld1_s8(v));
+    return {vmovl_s16(vget_low_s16(w)), vmovl_s16(vget_high_s16(w))};
+}
+
+template <int nrc_y>
+void mul_mat_q5k_u_r8_q8_k(int n, const void * vx, size_t bx, const DataInfo& info, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0);
+    Q8<nrc_y, block_q8_K> q8(info);
+    const int nbl = n / QK_K;
+    float32x4_t acc[2*nrc_y] = {};
+    for (int ix = 0; ix < nrc_x; ix += 8) {
+        const block_q5k_u_r8 * iq = (const block_q5k_u_r8 *)((const char *)vx + ix*bx);
+        for (int ibl = 0; ibl < nbl; ++ibl) {
+            int32x4_t sumi[2*nrc_y] = {}, summ[2*nrc_y] = {};
+            for (int sb = 0; sb < QK_K/32; ++sb) {
+                int32x4_t isum[2*nrc_y] = {};
+                for (int ib = 2*sb; ib < 2*sb + 2; ++ib) {
+                    const auto q1 = vld1q_s8_x4(iq[ibl].qs + 128*ib +  0);
+                    const auto q2 = vld1q_s8_x4(iq[ibl].qs + 128*ib + 64);
+                    for (int iy = 0; iy < nrc_y; ++iy) {
+                        const auto y = vld1q_s8(q8.y[iy][ibl].qs + 16*ib);
+                        isum[2*iy+0] = vdotq_laneq_s32(isum[2*iy+0], q1.val[0], y, 0);
+                        isum[2*iy+1] = vdotq_laneq_s32(isum[2*iy+1], q1.val[1], y, 0);
+                        isum[2*iy+0] = vdotq_laneq_s32(isum[2*iy+0], q1.val[2], y, 1);
+                        isum[2*iy+1] = vdotq_laneq_s32(isum[2*iy+1], q1.val[3], y, 1);
+                        isum[2*iy+0] = vdotq_laneq_s32(isum[2*iy+0], q2.val[0], y, 2);
+                        isum[2*iy+1] = vdotq_laneq_s32(isum[2*iy+1], q2.val[1], y, 2);
+                        isum[2*iy+0] = vdotq_laneq_s32(isum[2*iy+0], q2.val[2], y, 3);
+                        isum[2*iy+1] = vdotq_laneq_s32(isum[2*iy+1], q2.val[3], y, 3);
+                    }
+                }
+                const auto sc = widen_u8(iq[ibl].sc + 8*sb);
+                for (int iy = 0; iy < nrc_y; ++iy) {
+                    sumi[2*iy+0] = vmlaq_s32(sumi[2*iy+0], isum[2*iy+0], sc.val[0]);
+                    sumi[2*iy+1] = vmlaq_s32(sumi[2*iy+1], isum[2*iy+1], sc.val[1]);
+                }
+            }
+            // the mins once per block: sum over the 8 sub-blocks of m * (sum of their 32 activations)
+            for (int iy = 0; iy < nrc_y; ++iy) {
+                const int16x8_t b16 = vpaddq_s16(vld1q_s16(q8.y[iy][ibl].bsums), vld1q_s16(q8.y[iy][ibl].bsums + 8));
+                int16_t bs[8];
+                vst1q_s16(bs, b16);
+                for (int sb = 0; sb < QK_K/32; ++sb) {
+                    const auto mn = widen_u8(iq[ibl].m + 8*sb);
+                    summ[2*iy+0] = vmlaq_n_s32(summ[2*iy+0], mn.val[0], bs[sb]);
+                    summ[2*iy+1] = vmlaq_n_s32(summ[2*iy+1], mn.val[1], bs[sb]);
+                }
+            }
+            const auto d4l = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].d + 0));
+            const auto d4h = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].d + 4));
+            const auto m4l = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].dmin + 0));
+            const auto m4h = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].dmin + 4));
+            for (int iy = 0; iy < nrc_y; ++iy) {
+                const float d8 = q8.scale(iy, ibl);
+                acc[2*iy+0] = vfmaq_f32(acc[2*iy+0], vmulq_n_f32(d4l, d8), vcvtq_f32_s32(sumi[2*iy+0]));
+                acc[2*iy+1] = vfmaq_f32(acc[2*iy+1], vmulq_n_f32(d4h, d8), vcvtq_f32_s32(sumi[2*iy+1]));
+                acc[2*iy+0] = vfmsq_f32(acc[2*iy+0], vmulq_n_f32(m4l, d8), vcvtq_f32_s32(summ[2*iy+0]));
+                acc[2*iy+1] = vfmsq_f32(acc[2*iy+1], vmulq_n_f32(m4h, d8), vcvtq_f32_s32(summ[2*iy+1]));
+            }
+        }
+        for (int iy = 0; iy < nrc_y; ++iy) {
+            info.store(ix+0, iy, acc[2*iy+0]);
+            info.store(ix+4, iy, acc[2*iy+1]);
+            acc[2*iy+0] = acc[2*iy+1] = vdupq_n_f32(0.f);
+        }
+    }
+}
+
+template <int nrc_y>
+void mul_mat_q6k_u_r8_q8_k(int n, const void * vx, size_t bx, const DataInfo& info, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0);
+    Q8<nrc_y, block_q8_K> q8(info);
+    const int nbl = n / QK_K;
+    float32x4_t acc[2*nrc_y] = {};
+    for (int ix = 0; ix < nrc_x; ix += 8) {
+        const block_q6k_u_r8 * iq = (const block_q6k_u_r8 *)((const char *)vx + ix*bx);
+        for (int ibl = 0; ibl < nbl; ++ibl) {
+            int32x4_t sumi[2*nrc_y] = {};
+            for (int ib = 0; ib < QK_K/16; ++ib) {
+                const auto q1 = vld1q_s8_x4(iq[ibl].qs + 128*ib +  0);
+                const auto q2 = vld1q_s8_x4(iq[ibl].qs + 128*ib + 64);
+                const auto sc = widen_s8(iq[ibl].sc + 8*ib);
+                for (int iy = 0; iy < nrc_y; ++iy) {
+                    const auto y = vld1q_s8(q8.y[iy][ibl].qs + 16*ib);
+                    int32x4_t isum0 = vdotq_laneq_s32(vdupq_n_s32(0), q1.val[0], y, 0);
+                    int32x4_t isum1 = vdotq_laneq_s32(vdupq_n_s32(0), q1.val[1], y, 0);
+                    isum0 = vdotq_laneq_s32(isum0, q1.val[2], y, 1);
+                    isum1 = vdotq_laneq_s32(isum1, q1.val[3], y, 1);
+                    isum0 = vdotq_laneq_s32(isum0, q2.val[0], y, 2);
+                    isum1 = vdotq_laneq_s32(isum1, q2.val[1], y, 2);
+                    isum0 = vdotq_laneq_s32(isum0, q2.val[2], y, 3);
+                    isum1 = vdotq_laneq_s32(isum1, q2.val[3], y, 3);
+                    sumi[2*iy+0] = vmlaq_s32(sumi[2*iy+0], isum0, sc.val[0]);
+                    sumi[2*iy+1] = vmlaq_s32(sumi[2*iy+1], isum1, sc.val[1]);
+                }
+            }
+            const auto d4l = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].d + 0));
+            const auto d4h = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].d + 4));
+            for (int iy = 0; iy < nrc_y; ++iy) {
+                const float d8 = q8.scale(iy, ibl);
+                acc[2*iy+0] = vfmaq_f32(acc[2*iy+0], vmulq_n_f32(d4l, d8), vcvtq_f32_s32(sumi[2*iy+0]));
+                acc[2*iy+1] = vfmaq_f32(acc[2*iy+1], vmulq_n_f32(d4h, d8), vcvtq_f32_s32(sumi[2*iy+1]));
+            }
+        }
+        for (int iy = 0; iy < nrc_y; ++iy) {
+            info.store(ix+0, iy, acc[2*iy+0]);
+            info.store(ix+4, iy, acc[2*iy+1]);
+            acc[2*iy+0] = acc[2*iy+1] = vdupq_n_f32(0.f);
+        }
+    }
+}
+
+// ---- the same products with SMMLA (i8mm): a 2x8 block of weights (two rows) times an 8x2 block of
+//      activations (two tokens) per instruction, twice the multiply-adds of SDOT. Compiled for i8mm
+//      here only; off unless GGML_IQK_DENSE_I8MM=1 and the CPU has it (see Config).
+
+#define IQK_I8MM __attribute__((target("i8mm")))
+
+// [x0, x0, x1, x1] for the row pairs (0,1), (2,3) of v
+IQK_I8MM inline int32x4_t pair_lo(int32x4_t v) { return vzip1q_s32(v, v); }
+IQK_I8MM inline int32x4_t pair_hi(int32x4_t v) { return vzip2q_s32(v, v); }
+
+// activations of tokens t0 and t1, weights 32*sb + 8*kc ... + 7: [t0's 8, t1's 8] for kc = 0..3
+IQK_I8MM inline void load_pair(const block_q8_K * y0, const block_q8_K * y1, int sb, int8x16_t * b) {
+    const auto a0 = vreinterpretq_s64_s8(vld1q_s8(y0->qs + 32*sb)), a1 = vreinterpretq_s64_s8(vld1q_s8(y0->qs + 32*sb + 16));
+    const auto c0 = vreinterpretq_s64_s8(vld1q_s8(y1->qs + 32*sb)), c1 = vreinterpretq_s64_s8(vld1q_s8(y1->qs + 32*sb + 16));
+    b[0] = vreinterpretq_s8_s64(vzip1q_s64(a0, c0));
+    b[1] = vreinterpretq_s8_s64(vzip2q_s64(a0, c0));
+    b[2] = vreinterpretq_s8_s64(vzip1q_s64(a1, c1));
+    b[3] = vreinterpretq_s8_s64(vzip2q_s64(a1, c1));
+}
+
+// the 8 rows' results for tokens t0 and t1 from the 4 row-pair accumulators [r0t0, r0t1, r1t0, r1t1]
+IQK_I8MM inline void store_pairs(const DataInfo & info, int ix, int t0, bool has_t1, const float32x4_t * acc) {
+    info.store(ix+0, t0, vuzp1q_f32(acc[0], acc[1]));
+    info.store(ix+4, t0, vuzp1q_f32(acc[2], acc[3]));
+    if (has_t1) {
+        info.store(ix+0, t0 + 1, vuzp2q_f32(acc[0], acc[1]));
+        info.store(ix+4, t0 + 1, vuzp2q_f32(acc[2], acc[3]));
+    }
+}
+
+template <int nrc_y>
+IQK_I8MM void mul_mat_q5k_u_r8_q8_k_i8mm(int n, const void * vx, size_t bx, const DataInfo& info, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0);
+    Q8<nrc_y, block_q8_K> q8(info);
+    constexpr int np = (nrc_y + 1)/2;   // token pairs; an odd last token is paired with itself
+    const int nbl = n / QK_K;
+    for (int ix = 0; ix < nrc_x; ix += 8) {
+        const block_q5k_u_r8 * iq = (const block_q5k_u_r8 *)((const char *)vx + ix*bx);
+        float32x4_t acc[4*np] = {};
+        for (int ibl = 0; ibl < nbl; ++ibl) {
+            int32x4_t sumi[4*np] = {};
+            for (int sb = 0; sb < QK_K/32; ++sb) {
+                int8x16_t w[16];
+                for (int j = 0; j < 16; ++j) w[j] = vld1q_s8(iq[ibl].qs + 256*sb + 16*j);
+                const auto sc = widen_u8(iq[ibl].sc + 8*sb);
+                const int32x4_t scp[4] = {pair_lo(sc.val[0]), pair_hi(sc.val[0]), pair_lo(sc.val[1]), pair_hi(sc.val[1])};
+                for (int p = 0; p < np; ++p) {
+                    int8x16_t b[4];
+                    load_pair(q8.y[2*p] + ibl, q8.y[std::min(2*p + 1, nrc_y - 1)] + ibl, sb, b);
+                    for (int rp = 0; rp < 4; ++rp) {
+                        int32x4_t isum = vmmlaq_s32(vdupq_n_s32(0), w[rp], b[0]);
+                        isum = vmmlaq_s32(isum, w[4 + rp],  b[1]);
+                        isum = vmmlaq_s32(isum, w[8 + rp],  b[2]);
+                        isum = vmmlaq_s32(isum, w[12 + rp], b[3]);
+                        sumi[4*p + rp] = vmlaq_s32(sumi[4*p + rp], isum, scp[rp]);
+                    }
+                }
+            }
+            const auto d4l = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].d + 0));
+            const auto d4h = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].d + 4));
+            const auto m4l = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].dmin + 0));
+            const auto m4h = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].dmin + 4));
+            const float32x4_t dp[4] = {vzip1q_f32(d4l, d4l), vzip2q_f32(d4l, d4l), vzip1q_f32(d4h, d4h), vzip2q_f32(d4h, d4h)};
+            const float32x4_t mp[4] = {vzip1q_f32(m4l, m4l), vzip2q_f32(m4l, m4l), vzip1q_f32(m4h, m4h), vzip2q_f32(m4h, m4h)};
+            for (int p = 0; p < np; ++p) {
+                const int t0 = 2*p, t1 = std::min(2*p + 1, nrc_y - 1);
+                // the mins: sum over the sub-blocks of m * (sum of their 32 activations), per token
+                const int16x8_t bs0 = vpaddq_s16(vld1q_s16(q8.y[t0][ibl].bsums), vld1q_s16(q8.y[t0][ibl].bsums + 8));
+                const int16x8_t bs1 = vpaddq_s16(vld1q_s16(q8.y[t1][ibl].bsums), vld1q_s16(q8.y[t1][ibl].bsums + 8));
+                int16_t b0[8], b1[8];
+                vst1q_s16(b0, bs0);
+                vst1q_s16(b1, bs1);
+                int32x4_t summ[4] = {};
+                for (int sb = 0; sb < QK_K/32; ++sb) {
+                    const auto mn = widen_u8(iq[ibl].m + 8*sb);
+                    const int32x4_t bv = {b0[sb], b1[sb], b0[sb], b1[sb]};
+                    summ[0] = vmlaq_s32(summ[0], pair_lo(mn.val[0]), bv);
+                    summ[1] = vmlaq_s32(summ[1], pair_hi(mn.val[0]), bv);
+                    summ[2] = vmlaq_s32(summ[2], pair_lo(mn.val[1]), bv);
+                    summ[3] = vmlaq_s32(summ[3], pair_hi(mn.val[1]), bv);
+                }
+                const float32x4_t d8 = {q8.scale(t0, ibl), q8.scale(t1, ibl), q8.scale(t0, ibl), q8.scale(t1, ibl)};
+                for (int rp = 0; rp < 4; ++rp) {
+                    acc[4*p + rp] = vfmaq_f32(acc[4*p + rp], vmulq_f32(dp[rp], d8), vcvtq_f32_s32(sumi[4*p + rp]));
+                    acc[4*p + rp] = vfmsq_f32(acc[4*p + rp], vmulq_f32(mp[rp], d8), vcvtq_f32_s32(summ[rp]));
+                }
+            }
+        }
+        for (int p = 0; p < np; ++p) store_pairs(info, ix, 2*p, 2*p + 1 < nrc_y, acc + 4*p);
+    }
+}
+
+template <int nrc_y>
+IQK_I8MM void mul_mat_q6k_u_r8_q8_k_i8mm(int n, const void * vx, size_t bx, const DataInfo& info, int nrc_x) {
+    GGML_ASSERT(nrc_x%8 == 0);
+    Q8<nrc_y, block_q8_K> q8(info);
+    constexpr int np = (nrc_y + 1)/2;
+    const int nbl = n / QK_K;
+    for (int ix = 0; ix < nrc_x; ix += 8) {
+        const block_q6k_u_r8 * iq = (const block_q6k_u_r8 *)((const char *)vx + ix*bx);
+        float32x4_t acc[4*np] = {};
+        for (int ibl = 0; ibl < nbl; ++ibl) {
+            int32x4_t sumi[4*np] = {};
+            for (int sb = 0; sb < QK_K/32; ++sb) {
+                int8x16_t w[16];
+                for (int j = 0; j < 16; ++j) w[j] = vld1q_s8(iq[ibl].qs + 256*sb + 16*j);
+                // the 16-weight groups 2*sb (kc 0, 1) and 2*sb + 1 (kc 2, 3) have their own scales
+                const auto sa = widen_s8(iq[ibl].sc + 8*(2*sb));
+                const auto sz = widen_s8(iq[ibl].sc + 8*(2*sb + 1));
+                const int32x4_t spa[4] = {pair_lo(sa.val[0]), pair_hi(sa.val[0]), pair_lo(sa.val[1]), pair_hi(sa.val[1])};
+                const int32x4_t spz[4] = {pair_lo(sz.val[0]), pair_hi(sz.val[0]), pair_lo(sz.val[1]), pair_hi(sz.val[1])};
+                for (int p = 0; p < np; ++p) {
+                    int8x16_t b[4];
+                    load_pair(q8.y[2*p] + ibl, q8.y[std::min(2*p + 1, nrc_y - 1)] + ibl, sb, b);
+                    for (int rp = 0; rp < 4; ++rp) {
+                        int32x4_t ia = vmmlaq_s32(vdupq_n_s32(0), w[rp], b[0]);
+                        ia = vmmlaq_s32(ia, w[4 + rp], b[1]);
+                        int32x4_t iz = vmmlaq_s32(vdupq_n_s32(0), w[8 + rp], b[2]);
+                        iz = vmmlaq_s32(iz, w[12 + rp], b[3]);
+                        sumi[4*p + rp] = vmlaq_s32(sumi[4*p + rp], ia, spa[rp]);
+                        sumi[4*p + rp] = vmlaq_s32(sumi[4*p + rp], iz, spz[rp]);
+                    }
+                }
+            }
+            const auto d4l = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].d + 0));
+            const auto d4h = vcvt_f32_f16(vld1_f16((const float16_t *)iq[ibl].d + 4));
+            const float32x4_t dp[4] = {vzip1q_f32(d4l, d4l), vzip2q_f32(d4l, d4l), vzip1q_f32(d4h, d4h), vzip2q_f32(d4h, d4h)};
+            for (int p = 0; p < np; ++p) {
+                const int t0 = 2*p, t1 = std::min(2*p + 1, nrc_y - 1);
+                const float32x4_t d8 = {q8.scale(t0, ibl), q8.scale(t1, ibl), q8.scale(t0, ibl), q8.scale(t1, ibl)};
+                for (int rp = 0; rp < 4; ++rp) {
+                    acc[4*p + rp] = vfmaq_f32(acc[4*p + rp], vmulq_f32(dp[rp], d8), vcvtq_f32_s32(sumi[4*p + rp]));
+                }
+            }
+        }
+        for (int p = 0; p < np; ++p) store_pairs(info, ix, 2*p, 2*p + 1 < nrc_y, acc + 4*p);
+    }
+}
+
+bool cpu_has_i8mm() {
+#if defined(__linux__)
+    return (getauxval(AT_HWCAP2) & (1UL << 13)) != 0;   // HWCAP2_I8MM
+#elif defined(__APPLE__)
+    int v = 0;
+    size_t sz = sizeof(v);
+    return sysctlbyname("hw.optional.arm.FEAT_I8MM", &v, &sz, nullptr, 0) == 0 && v != 0;
+#else
+    return false;
+#endif
+}
+
+// one group of 8 rows (n/QK_K repacked blocks) unpacked, in the order the chosen kernel reads
+inline void iqk_unpack_dense_x8(int type, int interleave, bool i8mm, int n, const void * vx, void * vy) {
+    if (type == GGML_TYPE_Q5_K) {
+        if (i8mm) { if (interleave == 4) iqk_unpack_q5_k_x8<4, true >(n, vx, vy); else iqk_unpack_q5_k_x8<8, true >(n, vx, vy); }
+        else      { if (interleave == 4) iqk_unpack_q5_k_x8<4, false>(n, vx, vy); else iqk_unpack_q5_k_x8<8, false>(n, vx, vy); }
+    } else {
+        if (i8mm) { if (interleave == 4) iqk_unpack_q6_k_x8<4, true >(n, vx, vy); else iqk_unpack_q6_k_x8<8, true >(n, vx, vy); }
+        else      { if (interleave == 4) iqk_unpack_q6_k_x8<4, false>(n, vx, vy); else iqk_unpack_q6_k_x8<8, false>(n, vx, vy); }
+    }
+}
