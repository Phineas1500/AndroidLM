index 0000000..b627101
--- /dev/null
+++ b/ggml/src/ggml-cpu/test-iqk-dense.cpp
@@ -0,0 +1,217 @@
+// Accuracy of ggml_iqk_dense_mul_mat (iqk-moe.cpp) on repacked Q5_K and Q6_K weights, against a
+// double-precision reference computed from the dequantized weights and the Q8_K activations, next
+// to ggml's own vec_dot on the same data. The weights are random Q5_K / Q6_K rows, repacked here
+// with a verbatim copy of repack.cpp's make_block_q5_Kx8 / make_block_q6_Kx8 (static there).
+// Not part of the CMake build; on an aarch64 machine with dotprod, after a static build in build/:
+//   c++ -O2 -std=c++17 -mcpu=native -Iggml/include -Iggml/src -Iggml/src/ggml-cpu \
+//     ggml/src/ggml-cpu/test-iqk-dense.cpp build/ggml/src/libggml.a build/ggml/src/libggml-cpu.a \
+//     build/ggml/src/libggml-base.a -lpthread -lm -o test-iqk-dense && ./test-iqk-dense
+#define GGML_COMMON_DECL_CPP
+#include "ggml-common.h"
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "iqk-moe.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+struct block_q5_Kx8 {
+    ggml_half d[8];
+    ggml_half dmin[8];
+    uint8_t   scales[96];
+    uint8_t   qh[QK_K * 8 / 8];
+    uint8_t   qs[QK_K * 8 / 2];
+};
+struct block_q6_Kx8 {
+    ggml_half d[8];
+    int8_t    scales[QK_K / 16 * 8];
+    uint8_t   ql[QK_K / 2 * 8];
+    uint8_t   qh[QK_K / 4 * 8];
+};
+
+// ---- repack.cpp, verbatim
+static block_q5_Kx8 make_block_q5_Kx8(block_q5_K * in, unsigned int blck_size_interleave) {
+    block_q5_Kx8 out;
+    for (int i = 0; i < 8; i++) out.d[i] = in[i].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d;
+    for (int i = 0; i < 8; i++) out.dmin[i] = in[i].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin;
+    const int end = QK_K * 4 / blck_size_interleave;
+    for (int i = 0; i < end; ++i) {
+        int src_id = i % 8, src_offset = (i / 8) * blck_size_interleave, dst_offset = i * blck_size_interleave;
+        memcpy(&out.qs[dst_offset], &in[src_id].qs[src_offset], blck_size_interleave);
+    }
+    for (int i = 0; i < end / 4; ++i) {
+        int src_id = i % 8, src_offset = (i / 8) * blck_size_interleave, dst_offset = i * blck_size_interleave;
+        memcpy(&out.qh[dst_offset], &in[src_id].qh[src_offset], blck_size_interleave);
+    }
+    uint8_t s[8], m[8];
+    for (int i = 0; i < 4; i++) {
+        for (int j = 0; j < 8; j++) { s[j] = in[j].scales[i] & 63; m[j] = in[j].scales[i + 4] & 63; }
+        out.scales[i * 12]      = (s[0] & 63) + ((s[4] & 48) << 2);
+        out.scales[i * 12 + 1]  = (s[1] & 63) + ((s[5] & 48) << 2);
+        out.scales[i * 12 + 2]  = (s[2] & 63) + ((s[6] & 48) << 2);
+        out.scales[i * 12 + 3]  = (s[3] & 63) + ((s[7] & 48) << 2);
+        out.scales[i * 12 + 4]  = (m[0] & 63) + ((m[4] & 48) << 2);
+        out.scales[i * 12 + 5]  = (m[1] & 63) + ((m[5] & 48) << 2);
+        out.scales[i * 12 + 6]  = (m[2] & 63) + ((m[6] & 48) << 2);
+        out.scales[i * 12 + 7]  = (m[3] & 63) + ((m[7] & 48) << 2);
+        out.scales[i * 12 + 8]  = (s[4] & 15) + ((m[4] & 15) << 4);
+        out.scales[i * 12 + 9]  = (s[5] & 15) + ((m[5] & 15) << 4);
+        out.scales[i * 12 + 10] = (s[6] & 15) + ((m[6] & 15) << 4);
+        out.scales[i * 12 + 11] = (s[7] & 15) + ((m[7] & 15) << 4);
+    }
+    for (int i = 0; i < 4; i++) {
+        for (int j = 0; j < 8; j++) {
+            s[j] = ((in[j].scales[i] & 192) >> 2) | (in[j].scales[i + 8] & 15);
+            m[j] = ((in[j].scales[i + 4] & 192) >> 2) | ((in[j].scales[i + 8] & 240) >> 4);
+        }
+        out.scales[i * 12 + 48] = (s[0] & 63) + ((s[4] & 48) << 2);
+        out.scales[i * 12 + 49] = (s[1] & 63) + ((s[5] & 48) << 2);
+        out.scales[i * 12 + 50] = (s[2] & 63) + ((s[6] & 48) << 2);
+        out.scales[i * 12 + 51] = (s[3] & 63) + ((s[7] & 48) << 2);
+        out.scales[i * 12 + 52] = (m[0] & 63) + ((m[4] & 48) << 2);
+        out.scales[i * 12 + 53] = (m[1] & 63) + ((m[5] & 48) << 2);
+        out.scales[i * 12 + 54] = (m[2] & 63) + ((m[6] & 48) << 2);
+        out.scales[i * 12 + 55] = (m[3] & 63) + ((m[7] & 48) << 2);
+        out.scales[i * 12 + 56] = (s[4] & 15) + ((m[4] & 15) << 4);
+        out.scales[i * 12 + 57] = (s[5] & 15) + ((m[5] & 15) << 4);
+        out.scales[i * 12 + 58] = (s[6] & 15) + ((m[6] & 15) << 4);
+        out.scales[i * 12 + 59] = (s[7] & 15) + ((m[7] & 15) << 4);
+    }
+    return out;
+}
+
+static block_q6_Kx8 make_block_q6_Kx8(block_q6_K * in, unsigned int blck_size_interleave) {
+    block_q6_Kx8 out;
+    for (int i = 0; i < 8; i++) out.d[i] = in[i].d;
+    const int end_ls = QK_K * 4 / blck_size_interleave;
+    for (int i = 0; i < end_ls; ++i) {
+        int src_id = i % 8, src_offset = (i / 8) * blck_size_interleave, dst_offset = i * blck_size_interleave;
+        memcpy(&out.ql[dst_offset], &in[src_id].ql[src_offset], blck_size_interleave);
+    }
+    const int end_hs = end_ls / 2;
+    for (int i = 0; i < end_hs; ++i) {
+        int src_id = i % 8, src_offset = (i / 8) * blck_size_interleave, dst_offset = i * blck_size_interleave;
+        memcpy(&out.qh[dst_offset], &in[src_id].qh[src_offset], blck_size_interleave);
+    }
+    for (int i = 0; i < 8; i++) for (int j = 0; j < QK_K / 16; j++) out.scales[j * 8 + i] = in[i].scales[j];
+    return out;
+}
+// ----
+
+int main() {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    ggml_cpu_init();
+    std::mt19937 rng(7);
+    std::normal_distribution<float> nd(0.f, 1.f);
+    std::uniform_int_distribution<int> byte(0, 255);
+    int fails = 0;
+    for (int type : {GGML_TYPE_Q5_K, GGML_TYPE_Q6_K}) {
+        const auto * tt = ggml_get_type_traits((ggml_type) type);
+        const auto * tc = ggml_get_type_traits_cpu((ggml_type) type);
+        const auto * q8 = ggml_get_type_traits_cpu(GGML_TYPE_Q8_K);
+        for (int interleave : {4, 8}) {
+            for (int ne00 : {512, 2048}) {
+                const int Nx = 64, nb = ne00 / QK_K;
+                const size_t ra = ggml_row_size((ggml_type) type, ne00);
+                std::vector<uint8_t> A(Nx * ra);
+                for (auto & b : A) b = byte(rng);
+                for (int r = 0; r < Nx; ++r) {
+                    for (int ib = 0; ib < nb; ++ib) {
+                        uint8_t * blk = A.data() + r * ra + ib * ggml_type_size((ggml_type) type);
+                        ggml_half d = ggml_fp32_to_fp16(0.0005f + 0.002f * std::abs(nd(rng)));
+                        if (type == GGML_TYPE_Q5_K) {
+                            auto * x = (block_q5_K *) blk;
+                            x->GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d = d;
+                            x->GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin = ggml_fp32_to_fp16(0.0005f + 0.002f * std::abs(nd(rng)));
+                        } else {
+                            auto * x = (block_q6_K *) blk;
+                            x->d = d;
+                            for (auto & s : x->scales) s = (int8_t) (byte(rng) % 128 - 64);
+                        }
+                    }
+                }
+                std::vector<float> Af(Nx * ne00);
+                for (int r = 0; r < Nx; ++r) tt->to_float(A.data() + r * ra, Af.data() + r * ne00, ne00);
+
+                // repack: groups of 8 rows, each nb blocks
+                std::vector<uint8_t> R;
+                if (type == GGML_TYPE_Q5_K) {
+                    R.resize((Nx / 8) * nb * sizeof(block_q5_Kx8));
+                    auto * dst = (block_q5_Kx8 *) R.data();
+                    for (int g = 0; g < Nx / 8; ++g)
+                        for (int x = 0; x < nb; ++x) {
+                            block_q5_K tmp[8];
+                            for (int i = 0; i < 8; ++i) tmp[i] = ((const block_q5_K *) (A.data() + (8 * g + i) * ra))[x];
+                            *dst++ = make_block_q5_Kx8(tmp, interleave);
+                        }
+                } else {
+                    R.resize((Nx / 8) * nb * sizeof(block_q6_Kx8));
+                    auto * dst = (block_q6_Kx8 *) R.data();
+                    for (int g = 0; g < Nx / 8; ++g)
+                        for (int x = 0; x < nb; ++x) {
+                            block_q6_K tmp[8];
+                            for (int i = 0; i < 8; ++i) tmp[i] = ((const block_q6_K *) (A.data() + (8 * g + i) * ra))[x];
+                            *dst++ = make_block_q6_Kx8(tmp, interleave);
+                        }
+                }
+
+                for (int Ny : {32, 33, 100}) {
+                    std::vector<float> Bf(Ny * ne00);
+                    for (auto & v : Bf) v = nd(rng);
+                    const size_t rb = ggml_row_size(GGML_TYPE_Q8_K, ne00);
+                    std::vector<uint8_t> B(Ny * rb);
+                    for (int t = 0; t < Ny; ++t) q8->from_float(Bf.data() + t * ne00, B.data() + t * rb, ne00);
+                    std::vector<float> Bd(Ny * ne00);
+                    for (int t = 0; t < Ny; ++t) {   // Q8_K has no to_float
+                        const block_q8_K * b = (const block_q8_K *) (B.data() + t * rb);
+                        for (int ib = 0; ib < nb; ++ib)
+                            for (int i = 0; i < QK_K; ++i) Bd[t * ne00 + ib * QK_K + i] = b[ib].d * b[ib].qs[i];
+                    }
+
+                    std::vector<double> ref(Nx * Ny);
+                    double rms = 0;
+                    for (int t = 0; t < Ny; ++t)
+                        for (int r = 0; r < Nx; ++r) {
+                            double s = 0;
+                            for (int i = 0; i < ne00; ++i) s += (double) Af[r * ne00 + i] * Bd[t * ne00 + i];
+                            ref[t * Nx + r] = s;
+                            rms += s * s;
+                        }
+                    rms = std::sqrt(rms / (Nx * Ny));
+
+                    // ggml's vec_dot on the plain rows, for the error floor of the existing path
+                    double err_ggml = 0;
+                    for (int t = 0; t < Ny; ++t)
+                        for (int r = 0; r < Nx; ++r) {
+                            float s;
+                            tc->vec_dot(ne00, &s, 0, A.data() + r * ra, 0, B.data() + t * rb, 0, 1);
+                            err_ggml = std::max(err_ggml, std::abs(s - ref[t * Nx + r]));
+                        }
+
+                    // the dense path: rows handed out in two chunks, as threads would take them
+                    std::vector<float> C(Nx * Ny, NAN);
+                    const size_t nb1 = Nx * sizeof(float);
+                    ggml_iqk_dense_mul_mat(type, interleave, 0, 24, ne00, R.data(), B.data(), rb, C.data(), nb1, Ny);
+                    ggml_iqk_dense_mul_mat(type, interleave, 24, Nx, ne00, R.data(), B.data(), rb, C.data(), nb1, Ny);
+                    double err = 0, e2 = 0;
+                    for (int t = 0; t < Ny; ++t)
+                        for (int r = 0; r < Nx; ++r) {
+                            const double e = std::abs(C[t * Nx + r] - ref[t * Nx + r]);
+                            err = std::max(err, std::isnan(e) ? 1e30 : e);
+                            e2 += e * e;
+                        }
+                    const double rel = err / rms, rel_rms = std::sqrt(e2 / (Nx * Ny)) / rms, rel_ggml = err_ggml / rms;
+                    const bool ok = rel < 2e-5;  // integer arithmetic as in ggml's own dot products: rounding only
+                    fails += !ok;
+                    std::printf("%s interleave %d ne00 %4d Ny %3d: max err %.2e, rms err %.2e of the output RMS (ggml vec_dot max %.2e) %s\n",
+                                type == GGML_TYPE_Q5_K ? "q5_K" : "q6_K", interleave, ne00, Ny, rel, rel_rms, rel_ggml, ok ? "ok" : "FAIL");
+                }
+            }
+        }
+    }
+    std::printf("%s\n", fails ? "FAILED" : "all ok");
+    return fails != 0;
+}
