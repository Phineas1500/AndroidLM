<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- online build only. The setup downloader (SetupDownload.kt) fetches the model and corpus
         files into the app; nothing else in the app opens a connection, and research questions
         never reach it. The offline build declares neither permission nor the service. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- to tell Wi-Fi from mobile data before a 46GB download -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- plain http too, for a mirror on a home network: every file is checked against the
         manifest's SHA-256, so the connection cannot change what the app reads -->
    <application android:usesCleartextTraffic="true">
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
